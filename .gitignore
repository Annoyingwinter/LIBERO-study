# ---- environments & third-party source (re-installable, see env/environment.yml) ----
venv/
LIBERO/                      # LIBERO upstream checkout, 6.5G, pip install -e .
act/act_src/detr/**/__pycache__/
__pycache__/
*.py[cod]
*.so

# ---- datasets (too large; download script in scripts/download_data.sh) ----
*.hdf5
*.h5
data/
datasets/
task0_nextobs.hdf5

# ---- checkpoints (too large; hosted externally, see CHECKPOINTS below) ----
robomimic_out/
act/checkpoints/*.pth
*.pth
*.pt
*.ckpt
!media/checkpoints/.gitkeep

# ---- eval videos: full sets are gitignored, curated README media is force-added ----
eval_videos/
!media/**

# ---- logs: keep CSV metrics, drop verbose text ----
*.log
!*.csv

# ---- misc ----
.cache/
.DS_Store
.ipynb_checkpoints/
wandb/
outputs/
# eval sidecar files (regenerated by scripts/eval.py; the per-init-state CSV is
# the artifact worth keeping, the meta/episodes detail is not)
results/*.episodes.csv
results/*.meta.json
